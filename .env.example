# Local/private-network defaults. Copy to .env and edit for your capture host.
SERVER_ADDRESS=127.0.0.1
HTTP_PORT=8090
WEBRTC_HTTP_PORT=8889
WEBRTC_UDP_PORT=8189

CAPTURE_DIRECTORY=./captures
VIDEO_DEVICE=/dev/video0
AUDIO_DEVICE=hw:CARD=Device,DEV=0
VIDEO_STANDARD=PAL
# Match the host user and capture-device group IDs (`id` and `getent group video audio`).
PUID=1000
PGID=1000
VIDEO_GROUP_ID=44
AUDIO_GROUP_ID=29

PREVIEW_RESOLUTION=640x480
PREVIEW_VIDEO_BITRATE=800k
PREVIEW_AUDIO_BITRATE=64k
# Stop preview-only FFmpeg after this many seconds without a visible-dashboard heartbeat.
PREVIEW_IDLE_TIMEOUT_SECONDS=300
RECORDING_VIDEO_BITRATE=2000k
RECORDING_VIDEO_MAXRATE=2400k
RECORDING_VIDEO_BUFFER=4000k
RECORDING_AUDIO_BITRATE=128k
AUDIO_RATE=48000
AUDIO_CHANNELS=2

# Generate a SHA-256 fixity value in each completed recording's QC sidecar.
QC_CHECKSUM=true
# Decode the entire completed file during finalisation. Stronger but slower; disabled by default.
QC_FULL_DECODE=false

TZ=Etc/UTC
LOG_LEVEL=INFO
FFMPEG_LOG_LEVEL=warning

# Optional image/build metadata. Leave APP_IMAGE unset to build locally.
# APP_IMAGE=ghcr.io/paulcakeface/vhscribe:latest
SOURCE_URL=https://github.com/paulcakeface/vhscribe
BUILD_VERSION=dev
VCS_REF=unknown
